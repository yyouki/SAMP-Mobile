<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/textView9"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center_vertical"
        android:text="Settings"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <View
        android:id="@+id/view3"
        android:layout_width="160dp"
        android:layout_height="2dp"
        android:layout_marginBottom="5dp"
        android:background="#FF0037" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/settings_nickname"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/ic_nickname_bg"
                    android:ems="16"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center_vertical"
                    android:hint="Nickname"
                    android:inputType="textPersonName"
                    android:lines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Version"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinner"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="0.85" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textView7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Android Keyboard"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/keyboard_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:textOn=""
                            android:textOff="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textView28"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Voice chat"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/voice_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:textOn=""
                            android:textOff="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textView46"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Modified data"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/modify_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:textOn=""
                            android:textOff="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textView1868"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Monet Loader"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/monet_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:textOn=""
                            android:textOff="" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:background="#40464D" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textView29"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Display FPS"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/fps_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:textOn=""
                            android:textOff="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="vertical"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/textView8"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="Chat messages"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/messages_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="6"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatSeekBar
                            android:id="@+id/messages_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:max="3"
                            android:progress="1"
                            android:progressDrawable="@drawable/seekbar_drawable"
                            android:splitTrack="false"
                            android:thumb="@drawable/seekbar_thumb"
                            android:thumbTint="@android:color/transparent" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="vertical"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/textView35"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="FPS limit"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/fps_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_bold"
                                android:text="60"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatSeekBar
                            android:id="@+id/fps_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:max="3"
                            android:progress="1"
                            android:progressDrawable="@drawable/seekbar_drawable"
                            android:splitTrack="false"
                            android:thumb="@drawable/seekbar_thumb"
                            android:thumbTint="@android:color/transparent" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/textView14"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center_end"
        android:text="SA-MP Mobile"
        android:textColor="#AEAEAE"
        android:textSize="9sp" />
</LinearLayout>
