<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attach_main_layot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/attach_editor_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_attach_editor_panel"
        app:layout_constraintWidth_max="560dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBJECT / TOY ATTACHMENT"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="#FFE83A52" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Select a property, then hold − or + to adjust it."
            android:textColor="#FFBFC4CB"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="7dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="POSITION OFFSET"
                    android:textColor="#FF9FA6AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_leftright"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select position X">

                    <View
                        android:id="@+id/attach_leftright_butt"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Position X"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_topbott"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select position Y">

                    <View
                        android:id="@+id/attach_line2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Position Y"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_pushpull"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select position Z">

                    <View
                        android:id="@+id/attach_line3"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Position Z"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_marginStart="7dp"
                android:background="#FF42464D" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="7dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="ROTATION / SCALE"
                    android:textColor="#FF9FA6AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_rotX"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select rotation X">

                    <View
                        android:id="@+id/attach_line5"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotation X"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_rotY"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select rotation Y">

                    <View
                        android:id="@+id/attach_line6"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotation Y"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_rotZ"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select rotation Z">

                    <View
                        android:id="@+id/attach_line7"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotation Z"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/attach_scale"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Select scale">

                    <View
                        android:id="@+id/attach_line4"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/attach_black_round_rect"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scale"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LIVE TRANSFORM VALUES"
            android:textColor="#FF9FA6AF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/attach_current_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#FF25292F"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:padding="7dp"
            android:text="Loading object transform..."
            android:textColor="#FFF2F3F5"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ADJUST SELECTED PROPERTY"
            android:textColor="#FF9FA6AF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/attach_left_butt"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:backgroundTint="#FF41464E"
                android:text="−"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:contentDescription="Decrease selected property" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Hold for repeated adjustment"
                android:textColor="#FFBFC4CB"
                android:textSize="10sp" />

            <Button
                android:id="@+id/attach_right_button"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:backgroundTint="#FF41464E"
                android:text="+"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:contentDescription="Increase selected property" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#FF42464D" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/attach_exit_butt"
                android:layout_width="92dp"
                android:layout_height="36dp"
                android:backgroundTint="#FF353A41"
                android:text="CLOSE"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/attach_save_butt"
                android:layout_width="92dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFE83A52"
                android:text="SAVE"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
