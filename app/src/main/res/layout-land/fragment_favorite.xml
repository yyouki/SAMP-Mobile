<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/server_list_header"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="12dp"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:fontFamily="@font/montserrat_bold"
            android:text="SERVER / ADDRESS"
            android:textColor="@color/gray"
            android:textSize="9sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:paddingStart="10dp"
            android:text="MODE"
            android:textColor="@color/gray"
            android:textSize="9sp" />

        <TextView
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="PLAYERS"
            android:textColor="@color/gray"
            android:textSize="9sp" />
    </LinearLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/server_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="3dp"
        app:layout_constraintTop_toBottomOf="@id/server_list_header"
        app:layout_constraintBottom_toTopOf="@id/server_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/server_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/buttonServer"
            android:layout_width="132dp"
            android:layout_height="34dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/ic_buttoncolor"
            android:fontFamily="@font/montserrat_bold"
            android:text="ADD SERVER"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <Button
            android:id="@+id/buttonConnectServer"
            android:layout_width="160dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ic_buttoncolor"
            android:fontFamily="@font/montserrat_bold"
            android:text="CONNECT TO SERVER"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
